# Environment Configuration Example

# Django Core Settings
SECRET_KEY=your-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database (Neon PostgreSQL)
# Format: postgresql://[user]:[password]@[neon-endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-example.neon.tech/neondb?sslmode=require

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=True
# Or specify comma-separated allowed frontend domains:
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# CSRF Trusted Origins (Comma-separated)
# CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com,https://your-frontend.vercel.app
